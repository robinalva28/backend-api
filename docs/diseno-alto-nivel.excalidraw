      "boundElements": [],
      "updated": 1793134186519,
      "link": null,
      "locked": false,
      "text": "Errores estructurales → sin fila. Fallo técnico → diagnóstico interno y error público genérico. Hasta 3 reintentos adicionales de transacción completa para fallos\ntransitorios acordados.",
      "originalText": "Errores estructurales → sin fila. Fallo técnico → diagnóstico interno y error público genérico. Hasta 3 reintentos adicionales de transacción completa para fallos\ntransitorios acordados.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "index": "b3mk",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "seq_0185",
      "type": "text",
      "x": 4040,
      "y": 5790,
      "width": 1760,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
