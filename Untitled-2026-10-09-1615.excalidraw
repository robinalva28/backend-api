      "created": 1792864338855,
      "link": null,
      "locked": false,
      "text": "API DESIGN\n\nGET /users/:userid/portfolio -> \n200 OK \n{ \nuserid: integer, \ncurrency: \"ARS\", \naccountValue: decimalString, \ncashBalance: decimalString, \navaliableCash: decimalString, \npositions: [{instrumentid: integer, dailyReturnPercents: decimalString, ... }], \nwarnings: [{code: string, instrumentid?: integer}] \n} \n\nGET /instruments?query=... (tricker?, name?, limit?, offset?) default offset=100 \n-> 200 OK \n{\nitems: [{id: integer, ticker: string, name: string, type: \"ACCIONES\" }]\n}\n\nPOST /orders\n{\n  userId: integer,\n  instrumentId: integer,\n  side: \"BUY\" | \"SELL\",\n  type: \"MARKET\" | \"LIMIT\",\n  size?: integer,\n  amount?: decimalString,\n  price?: decimalString\n}\n\n-> 201 created\n{\n  order: {\n    id: integer,\n    userId: integer,\n    instrumentId: integer,\n    side: \"BUY\" | \"SELL\",\n    type: \"MARKET\" | \"LIMIT\",\n    size: integer,\n    price: decimalString,\n    status: \"FILLED\" | \"NEW\" | \"REJECTED\",\n    datetime: string\n  },\n  reason: null | \"INSUFFICIENT_CASH\" | \"INSUFFICIENT_SHARES\"\n}",
      "fontSize": 25.031525123985993,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "API DESIGN\n\nGET /users/:userid/portfolio -> \n200 OK \n{ \nuserid: integer, \ncurrency: \"ARS\", \naccountValue: decimalString, \ncashBalance: decimalString, \navaliableCash: decimalString, \npositions: [{instrumentid: integer, dailyReturnPercents: decimalString, ... }], \nwarnings: [{code: string, instrumentid?: integer}] \n} \n\nGET /instruments?query=... (tricker?, name?, limit?, offset?) default offset=100 \n-> 200 OK \n{\nitems: [{id: integer, ticker: string, name: string, type: \"ACCIONES\" }]\n}\n\nPOST /orders\n{\n  userId: integer,\n  instrumentId: integer,\n  side: \"BUY\" | \"SELL\",\n  type: \"MARKET\" | \"LIMIT\",\n  size?: integer,\n  amount?: decimalString,\n  price?: decimalString\n}\n\n-> 201 created\n{\n  order: {\n    id: integer,\n    userId: integer,\n    instrumentId: integer,\n    side: \"BUY\" | \"SELL\",\n    type: \"MARKET\" | \"LIMIT\",\n    size: integer,\n    price: decimalString,\n    status: \"FILLED\" | \"NEW\" | \"REJECTED\",\n    datetime: string\n  },\n  reason: null | \"INSUFFICIENT_CASH\" | \"INSUFFICIENT_SHARES\"\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
