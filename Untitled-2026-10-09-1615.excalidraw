    {
      "id": "mFVcJHMN4BYaH7pIAktdt",
      "type": "text",
      "x": 351.2307114466266,
      "y": 2342.454660173925,
      "width": 875.2734985351562,
      "height": 1439.3126946291948,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3U",
