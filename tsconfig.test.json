{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist-test",
    "noEmit": true,
    "esModuleInterop": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts",
    "vitest.unit.config.ts",
    "vitest.integration.config.ts",
    "vitest.http.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
