# Valores de desarrollo local para Compose y el arranque nativo.
PORT=3000
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=backend_api
PGUSER=backend_api
PGPASSWORD=backend-api-local
PGTESTPORT=5433

# Logging operativo JSON.
LOG_LEVEL=info
SLOW_REQUEST_THRESHOLD_MS=1000

# Modo remoto: usado solo por el servicio app-remote.
# No descomentar con credenciales reales en archivos versionados.
# DATABASE_URL=postgresql://usuario:contraseña@host:5432/base?sslmode=verify-full
# PGSSLROOTCERT=/ruta/al/ca.pem
# TLS verifica certificado y hostname; no usar ssl=0 ni uselibpqcompat=true.
# channel_binding=prefer habilita negociación opcional; require no está soportado.
# Sin channel_binding, se conserva disable. No repetir parámetros de la URL.
